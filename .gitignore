# Publish source code and repository documentation only.
/*
!/.gitignore
!/README.md
!/code/
!/experiments/

# Keep experiment source; exclude results, datasets and local notes.
/experiments/**
!/experiments/**/
!/experiments/**/*.py
!/experiments/**/*.sh

# Local environments, credentials and editor state.
.venv/
venv/
.env
.env.*
*.pem
*.key
.DS_Store
.idea/
.vscode/

# Python, notebook and test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Generated data, model weights, run outputs and archives.
artifacts/
dama-data/
dama-runs/
dama_work/
runs/
checkpoints/
outputs/
*.safetensors
*.pt
*.pth
*.onnx
*.onnx.data
*.zip
*.tar
*.tar.gz
*.log
*.sqlite*
*.db
